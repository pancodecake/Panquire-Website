---
import Base from '../../layouts/Base.astro';
import {
  site,
  models,
  specTabs,
  shots,
  comparison,
  logistics,
  purchaseFacts,
  pricing,
  specDisclaimer,
  panorama,
  withBase,
} from '../../data/site';
import { hasAsset } from '../../data/assets';

const [t01] = models;

// The product design crops one photograph four ways. Until it is exported
// from the design project, every crop falls back to a labelled slot.
const photo = hasAsset('/photos/t01.jpg');

const title = 'T-01 electric dirt bike';
const description =
  'Panquire T-01: a 60V 3,000 W central motor peaking at 8,000 W, 80 km/h top speed, 80 km eco range, 150 kg rated load and 55 kg net weight. Wholesale from 10 units.';

const tagline =
  'Built to be ridden hard, serviced with hand tools, and shipped 210 to a forty-foot container.';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    '@id': `${site.url}/products/t-01#product`,
    name: 'Panquire T-01 Electric Dirt Bike',
    sku: 'T-01',
    brand: { '@type': 'Brand', name: site.name },
    description,
    offers: {
      '@type': 'Offer',
      price: pricing.t01.amount,
      priceCurrency: pricing.currency,
      availability: 'https://schema.org/PreOrder',
      url: `${site.url}/products/t-01`,
      seller: { '@id': `${site.url}/#organization` },
      eligibleQuantity: { '@type': 'QuantitativeValue', minValue: pricing.wholesale.moq, unitText: 'units' },
      deliveryLeadTime: { '@type': 'QuantitativeValue', minValue: 25, maxValue: 30, unitCode: 'DAY' },
    },
    additionalProperty: t01.specs.performance.map(([name, value]) => ({
      '@type': 'PropertyValue',
      name,
      value,
    })),
    disambiguatingDescription: specDisclaimer,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'T-01', item: `${site.url}/products/t-01` },
    ],
  },
];
---

<Base title={title} description={description} schema={schema}>
  <div class="tech">
    <!-- ========== 1 · PURCHASE ========== -->
    <section class="buy" aria-labelledby="product-title">
      <div class="page--tech buy__grid">
        <!-- ---------- Gallery ----------
             One photograph, four crops. The design zooms the same asset
             rather than shipping four files. -->
        <div class="gallery">
          <div class="gallery__stage">
            <div class="gallery__frame">
              {photo ? (
                <img
                  class="gallery__img lighten"
                  id="gallery-img"
                  src={withBase('/photos/t01.jpg')}
                  alt="Panquire T-01 electric dirt bike, three-quarter front view"
                  style={`transform:${shots[0].transform}`}
                  width="1200"
                  height="1200"
                />
              ) : (
                <div class="gallery__img slot" id="gallery-img" role="img" aria-label="T-01 product photograph">
                  T-01 product photograph
                </div>
              )}
            </div>
            <span class="gallery__label" data-shot-label>{shots[0].label}</span>
            <span class="gallery__count"><span data-shot-no>01</span> / 0{shots.length}</span>
          </div>

          <div class="gallery__thumbs" role="group" aria-label="Product views">
            {shots.map((s, i) => (
              <button
                class="thumb"
                type="button"
                aria-pressed={i === 0 ? 'true' : 'false'}
                data-shot={s.transform}
                data-shot-name={s.label}
                data-shot-index={i + 1}
              >
                {photo ? (
                  <img class="thumb__img lighten" src={withBase('/photos/t01.jpg')} alt="" style={`transform:${s.transform}`} loading="lazy" width="300" height="225" />
                ) : (
                  <span class="thumb__img slot" aria-hidden="true"></span>
                )}
                <span class="thumb__label">{s.label}</span>
              </button>
            ))}
          </div>
        </div>

        <!-- ---------- Purchase panel ---------- -->
        <div class="panel" id="quote">
          <p class="eyebrow eyebrow--tech">Electric dirt bike</p>

          {/* One h1 for the page, retitled on model switch — the alternative
              is a second h1 sitting hidden in the markup. */}
          <h1 id="product-title" class="panel__title" data-model-text="name">{t01.name}</h1>

          {models.map((m, i) => (
            <div class="panel__model" data-model-view={m.id} hidden={i !== 0}>
              <p class="panel__blurb">{m.blurb}</p>

              <dl class="readout">
                <div><dt>Top speed</dt><dd>{m.speed}</dd></div>
                <div><dt>Peak power</dt><dd>{m.peakShort}</dd></div>
                <div><dt>Eco range</dt><dd>{m.range}</dd></div>
                <div><dt>Battery</dt><dd>{m.battery}</dd></div>
              </dl>
            </div>
          ))}

          <div class="price">
            <div>
              <p class="price__value">Price on request</p>
              <p class="price__terms">{pricing.wholesale.terms}</p>
            </div>
            <p class="price__status">
              In production<br />
              <span>Lead time 25 to 30 days</span>
            </p>
          </div>

          <div class="choose">
            <p class="choose__label" id="model-label">Model</p>
            <div class="choose__opts" role="group" aria-labelledby="model-label">
              {models.map((m, i) => (
                <button class="opt" type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-model={m.id}>
                  <span class="opt__name">{m.name}</span>
                  <span class="opt__sub">{m.sub}</span>
                </button>
              ))}
            </div>
          </div>

          <div class="config">
            <div>
              <p class="choose__label" id="finish-label">Finish</p>
              <div class="finish" aria-labelledby="finish-label">
                <span class="finish__chip" aria-hidden="true"></span>
                <span>Matte black</span>
              </div>
            </div>
            <div>
              <p class="choose__label" id="qty-label">Quantity</p>
              <div class="qty">
                <button class="qty__btn" type="button" data-qty="-1" aria-label="Decrease quantity">&#8722;</button>
                <output class="qty__value" data-qty-value aria-labelledby="qty-label">{pricing.wholesale.moq}</output>
                <button class="qty__btn" type="button" data-qty="1" aria-label="Increase quantity">+</button>
              </div>
              <p class="qty__min">Minimum {pricing.wholesale.moq} units</p>
            </div>
          </div>

          <div class="panel__actions">
            <a class="btn btn--tech" href={withBase('/partners#corporate')}>Request a quote</a>
            <a class="btn btn--tech btn--tech-quiet" href="#specs">Download spec sheet</a>
          </div>

          <dl class="facts">
            {purchaseFacts.map((f) => (
              <div class="facts__cell">
                <dt>{f.label}</dt>
                <dd>{f.value}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </section>

    <!-- ========== 2 · PANORAMIC ========== -->
    <section class="pano" data-reveal aria-label="T-01 in full profile">
      <div class="pano__glow" aria-hidden="true"></div>
      <div class="page--tech pano__inner">
        <p class="eyebrow eyebrow--tech">Panoramic view</p>
        <div class="spin" data-spin={JSON.stringify(panorama)}>
          <div class="spin__frame">
            <img
              class="spin__poster"
              src={panorama['T-01'].poster}
              alt="Panquire T-01 electric dirt bike, three-quarter front view"
              width={panorama['T-01'].posterWidth}
              height={panorama['T-01'].posterHeight}
              loading="lazy"
              decoding="async"
            />
            <canvas class="spin__canvas" aria-hidden="true"></canvas>
          </div>
          <span class="spin__floor" aria-hidden="true"></span>
          <div class="spin__hit" data-spin-hit hidden></div>
          <span class="spin__badge" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3.5 12a8.5 8.5 0 0 1 14.3-6.2" />
              <path d="M18 2.8v3.4h-3.4" />
              <path d="M20.5 12a8.5 8.5 0 0 1-14.3 6.2" />
              <path d="M6 21.2v-3.4h3.4" />
            </svg>
            360°
          </span>
        </div>
        <p class="pano__caption">
          <span data-model-text="name">T-01</span> &nbsp;/&nbsp; Matte black
          <span>Studio capture, no accessories fitted</span>
        </p>
      </div>
    </section>

    <div class="gap gap--a"></div>

    <!-- ========== 3 · PERFORMANCE ==========
         A five-cell grid held together by 1px dividers rather than gaps,
         so the block reads as one instrument panel. -->
    <section class="section-tech" data-reveal aria-labelledby="perf-title">
      <div class="page--tech">
        <div class="centered">
          <p class="kicker">Performance</p>
          <h2 id="perf-title" class="h-tech">What the drivetrain is made of</h2>
        </div>

        <div class="bento">
          <div class="bento__cell bento__cell--tall">
            <!-- TODO(asset): central motor close-up. -->
            <img class="bento__media media-fill" src={withBase('/photos/t01.jpg')} alt="T-01 central motor and frame" width="1008" height="1056" loading="lazy" decoding="async" />
            <div class="bento__caption">
              <p class="kicker">Central motor</p>
              <p class="bento__value" data-model-text="motorShort">{t01.motorShort}</p>
            </div>
          </div>

          <div class="bento__cell bento__cell--text">
            <p class="kicker">Peak output</p>
            <div>
              <p class="bento__big" data-model-text="peak">{t01.peak}</p>
              <p class="bento__note">
                Held through the mid range by a 3-speed chain drive, so the
                gear does the work the throttle would otherwise have to.
              </p>
            </div>
          </div>

          <div class="bento__cell bento__cell--text">
            <p class="kicker">Pack</p>
            <div>
              <p class="bento__mid" data-model-text="battery">{t01.battery}</p>
              <p class="bento__note">
                Lithium, charged at 6 A. Rated <span data-model-text="range">{t01.range}</span> in eco mode.
              </p>
            </div>
          </div>

          <div class="bento__cell">
            <!-- TODO(asset): rear shock detail. -->
            <img class="bento__media media-fill" src={withBase('/photos/t01.jpg')} alt="T-01 rear shock and swingarm" width="1008" height="1056" loading="lazy" decoding="async" />
            <div class="bento__caption">
              <p class="kicker">Rear shock</p>
              <p class="bento__small">Adjustable oil hydraulic nitrogen</p>
            </div>
          </div>

          <div class="bento__cell bento__cell--text">
            <p class="kicker">Wheels and brakes</p>
            <div>
              <p class="bento__mid">19&Prime; front<br />17&Prime; rear</p>
              <p class="bento__note">Hydraulic disc brakes at both ends, hydraulic pads.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ========== 4 · THREE GEARS ========== -->
    <section class="section-tech section-tech--gap" data-reveal aria-labelledby="gears-title">
      <div class="page--tech gears">
        <!-- TODO(asset): cockpit or display photo. -->
        <img class="gears__media media-fill" src={withBase('/photos/t01.jpg')} alt="Panquire T-01 electric dirt bike" width="1008" height="1056" loading="lazy" decoding="async" />

        <div class="gears__panel">
          <p class="eyebrow eyebrow--tech">Three gears</p>
          <h2 id="gears-title" class="h-tech h-tech--sm">One throttle, three characters</h2>
          <p class="gears__lede">
            The 3-speed drivetrain is what makes one bike work for a fire road
            and a hill climb. Pick the gear, and the motor map follows.
          </p>

          <dl class="gears__list">
            <div><dt>Gear 1 &nbsp;&middot;&nbsp; Eco</dt><dd><span data-model-text="range">{t01.range}</span> rated range</dd></div>
            <div><dt>Gear 2 &nbsp;&middot;&nbsp; Trail</dt><dd>Gradients under 30&deg;</dd></div>
            <div><dt>Gear 3 &nbsp;&middot;&nbsp; Open</dt><dd><span data-model-text="speed">{t01.speed}</span> top speed</dd></div>
          </dl>

          <p class="gears__note">
            Rated load 150 kg, so a rider plus a loaded pack stays inside the
            envelope.
          </p>
        </div>
      </div>
    </section>

    <!-- ========== 5 · TAGLINE ==========
         The one orchestrated moment on the page: the line lights word by
         word as it arrives. -->
    <section class="tagline" data-reveal aria-label="Statement">
      <p class="tagline__line" data-tagline>
        {tagline.split(' ').map((w) => <span class="tagline__word">{w} </span>)}
      </p>
    </section>

    <!-- ========== 6 · SPECIFICATIONS ========== -->
    <section class="section-tech" id="specs" data-reveal aria-labelledby="specs-title">
      <div class="page--tech">
        <p class="eyebrow eyebrow--tech">Specs and parameters</p>
        <h2 id="specs-title" class="h-tech specs__title">
          Every number on <span data-model-text="name">T-01</span>
        </h2>

        <div class="specs">
          <!-- Dimension drawing. The measure lines are the design's own
               device and carry the two published dimensions. -->
          <figure class="drawing">
            {photo ? (
              <img class="drawing__img" src={withBase('/photos/t01.jpg')} alt="Side view of the T-01 used as a dimension reference" width="920" height="700" loading="lazy" />
            ) : (
              <div class="drawing__img slot">T-01 side view</div>
            )}
            <span class="drawing__axis drawing__axis--x" aria-hidden="true"></span>
            <span class="drawing__tick drawing__tick--l" aria-hidden="true"></span>
            <span class="drawing__tick drawing__tick--r" aria-hidden="true"></span>
            <figcaption class="drawing__dim drawing__dim--x">1770 mm</figcaption>
            <span class="drawing__axis drawing__axis--y" aria-hidden="true"></span>
            <span class="drawing__dim drawing__dim--y">1200 mm</span>
          </figure>

          <div class="specs__panel">
            <div class="spec-tabs" role="tablist" aria-label="Specification groups">
              {specTabs.map((t, i) => (
                <button
                  class="spec-tab"
                  role="tab"
                  type="button"
                  id={`spectab-${t.id}`}
                  aria-controls={`specpanel-${t.id}`}
                  aria-selected={i === 0 ? 'true' : 'false'}
                  tabindex={i === 0 ? 0 : -1}
                  data-spec-tab={t.id}
                >{t.label}</button>
              ))}
            </div>

            {models.map((m) =>
              specTabs.map((t, i) => (
                <div
                  class="spec-rows"
                  role="tabpanel"
                  id={m.id === 'T-01' ? `specpanel-${t.id}` : undefined}
                  aria-labelledby={m.id === 'T-01' ? `spectab-${t.id}` : undefined}
                  data-spec-panel={t.id}
                  data-spec-model={m.id}
                  hidden={!(m.id === 'T-01' && i === 0)}
                >
                  <h3 class="visually-hidden">{m.name} — {t.label}</h3>
                  <dl>
                    {m.specs[t.id].map(([k, v]) => (
                      <div class="spec-row">
                        <dt>{k}</dt>
                        <dd>{v}</dd>
                      </div>
                    ))}
                  </dl>
                </div>
              ))
            )}
          </div>
        </div>
      </div>
    </section>

    <div class="gap gap--b"></div>

    <!-- ========== 7 · COMPARISON ========== -->
    <section class="section-tech" id="compare" data-reveal aria-labelledby="compare-title">
      <div class="page--tech">
        <p class="eyebrow eyebrow--tech">Parameter comparison</p>
        <h2 id="compare-title" class="h-tech specs__title">T-01 next to T-02</h2>

        <div class="table-scroll">
          <table class="compare">
            <caption class="visually-hidden">Panquire T-01 and T-02 specifications compared.</caption>
            <thead>
              <tr>
                <th scope="col" class="compare__param">Parameter</th>
                <th scope="col" class="compare__model" data-compare-col="T-01">T-01</th>
                <th scope="col" class="compare__model" data-compare-col="T-02">T-02</th>
              </tr>
            </thead>
            <tbody>
              {comparison.map(([label, a, b]) => (
                <tr>
                  <th scope="row">{label}</th>
                  <td>{a}</td>
                  <td>{b}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ========== 8 · LOGISTICS ========== -->
    <section class="section-tech section-tech--gap" data-reveal aria-labelledby="logistics-title">
      <div class="page--tech">
        <h2 id="logistics-title" class="visually-hidden">Logistics</h2>
        <dl class="logistics">
          {logistics.map((l) => (
            <div class="logistics__cell">
              <dt>{l.label}</dt>
              <dd>{l.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- ========== 9 · DISCLAIMER ========== -->
    <section class="disclaimer" aria-labelledby="disclaimer-title">
      <div class="page--tech">
        <div class="disclaimer__row">
          <p class="disclaimer__mark" aria-hidden="true">{site.name}</p>
          <nav class="disclaimer__links" aria-label="Product page">
            <a href={withBase('/partners#corporate')}>Request a quote</a>
            <a href="#specs">Specifications</a>
            <a href="#compare">Compare</a>
          </nav>
        </div>
        <h2 id="disclaimer-title" class="visually-hidden">Important notes on these figures</h2>
        <p class="disclaimer__text">{specDisclaimer}</p>
      </div>
    </section>
  </div>
</Base>

<script>
  /* ============================================================
     Product page behaviour. Every state is already in the DOM —
     both models, all four spec groups — so this only ever toggles
     `hidden` and `aria-pressed`. Nothing is built from strings,
     and every number stays crawlable with JavaScript off.
     ============================================================ */

  // ---------- Gallery ----------
  const img = document.getElementById('gallery-img') as HTMLImageElement | null;
  const shotLabel = document.querySelector<HTMLElement>('[data-shot-label]');
  const shotNo = document.querySelector<HTMLElement>('[data-shot-no]');
  const thumbs = Array.from(document.querySelectorAll<HTMLButtonElement>('.thumb'));

  thumbs.forEach((btn) => {
    btn.addEventListener('click', () => {
      thumbs.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      if (img) img.style.transform = btn.dataset.shot ?? '';
      if (shotLabel) shotLabel.textContent = btn.dataset.shotName ?? '';
      if (shotNo) shotNo.textContent = '0' + (btn.dataset.shotIndex ?? '1');
    });
  });

  // ---------- Panoramic 360° viewer ----------
  // Frames draw to a canvas. Auto-rotation runs on requestAnimationFrame at
  // an even angular speed — the manifest maps angle to frame, undoing the
  // render's ease-in — and a drag, a swipe or the arrow keys take over until
  // the user lets go, after which it eases back up to speed.
  type SpinSet = {
    frames: string;
    poster: string;
    secondsPerTurn: number;
    resumeAfterMs: number;
    reverseDrag: boolean;
  };
  type SpinManifest = { prefix: string; count: number; width: number; height: number; angles?: number[] };

  function createSpin(root: HTMLElement) {
    const sets = JSON.parse(root.dataset.spin ?? '{}') as Record<string, SpinSet>;
    const canvas = root.querySelector<HTMLCanvasElement>('.spin__canvas')!;
    const poster = root.querySelector<HTMLImageElement>('.spin__poster')!;
    const hit = root.querySelector<HTMLElement>('[data-spin-hit]')!;
    const ctx = canvas.getContext('2d')!;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let id = Object.keys(sets)[0];
    let set = sets[id];
    let manifest: SpinManifest | null = null;
    let images: HTMLImageElement[] = [];
    let ready: boolean[] = [];
    let readyCount = 0;
    let generation = 0;

    let angle = 0; // degrees
    let drawn = -1; // frame currently on the canvas
    let mode: 'idle' | 'auto' | 'dragging' = 'idle';
    let near = false;
    let raf = 0;
    let drawRaf = 0;
    let lastTick = 0;
    let rampStart = 0;
    let resumeTimer = 0;
    let dragX = 0;
    let dragWidth = 1;
    let touched = false; // the user has taken hold at least once

    // The interaction layer only exists with JavaScript. Without it the
    // section is the product photograph and nothing pretends to be a control.
    hit.hidden = false;
    hit.tabIndex = 0;
    hit.setAttribute('role', 'slider');
    hit.setAttribute('aria-label', 'Rotate the bike. Drag, or use the left and right arrow keys.');
    hit.setAttribute('aria-valuemin', '0');
    hit.setAttribute('aria-valuemax', '359');
    root.classList.add('is-live');

    const wrap = (deg: number) => ((deg % 360) + 360) % 360;

    /** Last frame whose angle is at or below `deg`. */
    function frameAt(deg: number) {
      const m = manifest!;
      const a = wrap(deg);
      if (!m.angles) return Math.floor((a / 360) * m.count) % m.count;
      let lo = 0;
      let hi = m.count - 1;
      while (lo < hi) {
        const mid = (lo + hi + 1) >> 1;
        if (m.angles[mid] <= a) lo = mid;
        else hi = mid - 1;
      }
      return lo;
    }

    /** Early in the load only some frames are decoded: use the nearest one. */
    function nearestReady(i: number) {
      const n = ready.length;
      for (let d = 0; d < n; d++) {
        if (ready[(i + d) % n]) return (i + d) % n;
        if (ready[(i - d + n) % n]) return (i - d + n) % n;
      }
      return -1;
    }

    function draw() {
      if (!manifest || !canvas.width) return;
      const i = nearestReady(frameAt(angle));
      if (i < 0 || i === drawn) return;
      ctx.drawImage(images[i], 0, 0, canvas.width, canvas.height);
      drawn = i;
      root.classList.add('is-ready');
    }

    function fit() {
      const box = canvas.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const w = Math.round(box.width * dpr);
      const h = Math.round(box.height * dpr);
      if (w === canvas.width && h === canvas.height) return;
      canvas.width = w;
      canvas.height = h;
      ctx.imageSmoothingEnabled = true;
      ctx.imageSmoothingQuality = 'high';
      drawn = -1;
      draw();
    }

    function tick(now: number) {
      raf = 0;
      if (mode !== 'auto' || !near) return;
      const dt = lastTick ? Math.min(now - lastTick, 100) : 0;
      lastTick = now;
      // Ease back up to speed after an interaction instead of lurching off.
      const t = Math.min(1, (now - rampStart) / 700);
      const speed = 1 - (1 - t) ** 3;
      angle = wrap(angle + (360 / (set.secondsPerTurn * 1000)) * dt * speed);
      draw();
      raf = requestAnimationFrame(tick);
    }

    function startAuto() {
      if (reduce || !manifest) return;
      mode = 'auto';
      rampStart = performance.now();
      lastTick = 0;
      if (near && !raf) raf = requestAnimationFrame(tick);
    }

    function stopAuto() {
      if (mode === 'auto') mode = 'idle';
      if (raf) cancelAnimationFrame(raf);
      raf = 0;
    }

    function resumeLater() {
      window.clearTimeout(resumeTimer);
      resumeTimer = window.setTimeout(startAuto, set.resumeAfterMs);
    }

    function announce() {
      const deg = Math.round(wrap(angle)) % 360;
      hit.setAttribute('aria-valuenow', String(deg));
      hit.setAttribute('aria-valuetext', `${deg}°`);
    }

    async function load(nextId: string) {
      const gen = ++generation;
      id = nextId;
      set = sets[id];
      const m = (await fetch(`${set.frames}manifest.json`).then((r) => r.json())) as SpinManifest;
      if (gen !== generation) return;
      manifest = m;
      images = new Array(m.count);
      ready = new Array(m.count).fill(false);
      readyCount = 0;
      drawn = -1;
      angle = 0;
      announce();

      // Coarse to fine: every 16th frame, then every 8th, and so on — the
      // turntable responds after a handful of requests and sharpens as it loads.
      const order: number[] = [];
      const queued = new Set<number>();
      for (let stride = 16; stride >= 1; stride /= 2) {
        for (let i = 0; i < m.count; i += stride) {
          if (queued.has(i)) continue;
          queued.add(i);
          order.push(i);
        }
      }

      let cursor = 0;
      const pull = async () => {
        while (cursor < order.length && gen === generation) {
          const i = order[cursor++];
          const img = new Image();
          img.decoding = 'async';
          img.src = `${set.frames}${m.prefix}${String(i).padStart(3, '0')}.webp`;
          images[i] = img;
          try {
            await img.decode();
          } catch {
            continue; // a frame that fails to load falls back to its neighbour
          }
          if (gen !== generation) return;
          ready[i] = true;
          readyCount++;
          if (mode !== 'dragging') draw();
          // Start turning once half the frames are in, unless the user has
          // already taken hold of it.
          if (!touched && mode === 'idle' && readyCount >= m.count / 2) startAuto();
        }
      };
      await Promise.all(Array.from({ length: 6 }, pull));
    }

    // Drag on desktop, swipe on touch. `touch-action: pan-y` keeps vertical
    // swipes scrolling the page.
    hit.addEventListener('pointerdown', (e) => {
      if (e.button !== 0 || !manifest) return;
      hit.setPointerCapture(e.pointerId);
      touched = true;
      stopAuto();
      window.clearTimeout(resumeTimer);
      mode = 'dragging';
      dragX = e.clientX;
      dragWidth = hit.getBoundingClientRect().width || 1;
      root.classList.add('is-dragging');
    });
    hit.addEventListener('pointermove', (e) => {
      if (mode !== 'dragging') return;
      const dx = e.clientX - dragX;
      dragX = e.clientX;
      // One full turn per width of the viewer dragged.
      angle = wrap(angle + (set.reverseDrag ? 1 : -1) * (dx / dragWidth) * 360);
      if (!drawRaf) {
        drawRaf = requestAnimationFrame(() => {
          drawRaf = 0;
          draw();
        });
      }
    });
    const release = () => {
      if (mode !== 'dragging') return;
      mode = 'idle';
      root.classList.remove('is-dragging');
      announce();
      resumeLater();
    };
    hit.addEventListener('pointerup', release);
    hit.addEventListener('pointercancel', release);
    hit.addEventListener('lostpointercapture', release);

    hit.addEventListener('keydown', (e) => {
      const step = e.shiftKey ? 45 : 10;
      let next: number | null = null;
      if (e.key === 'ArrowRight' || e.key === 'ArrowUp') next = angle + step;
      else if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') next = angle - step;
      else if (e.key === 'Home') next = 0;
      if (next === null || !manifest) return;
      e.preventDefault();
      touched = true;
      stopAuto();
      angle = wrap(next);
      draw();
      announce();
      resumeLater();
    });

    new ResizeObserver(fit).observe(canvas);

    // Load half a screen before the viewer arrives; only turn while it is near.
    new IntersectionObserver(
      ([entry]) => {
        near = entry.isIntersecting;
        if (!near) return;
        if (generation === 0) void load(id);
        if (mode === 'auto' && !raf) {
          lastTick = 0;
          raf = requestAnimationFrame(tick);
        }
      },
      { rootMargin: '50% 0px' }
    ).observe(root);

    return {
      /** Swap to another model's turntable; a no-op when both share a set. */
      setModel(nextId: string) {
        const next = sets[nextId];
        if (!next || next.frames === set.frames) return;
        stopAuto();
        root.classList.remove('is-ready');
        poster.src = next.poster;
        touched = false;
        void load(nextId);
      },
    };
  }

  const spinRoot = document.querySelector<HTMLElement>('[data-spin]');
  const spin = spinRoot ? createSpin(spinRoot) : null;


  // ---------- Model switch ----------
  const modelBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-model]'));
  const modelViews = Array.from(document.querySelectorAll<HTMLElement>('[data-model-view]'));
  const modelTexts = Array.from(document.querySelectorAll<HTMLElement>('[data-model-text]'));
  const compareCols = Array.from(document.querySelectorAll<HTMLElement>('[data-compare-col]'));
  const specPanels = Array.from(document.querySelectorAll<HTMLElement>('[data-spec-panel]'));

  // Values the inline copy interpolates, read off the rendered panels so
  // there is no second copy of the spec data on the client.
  const field = (model: string, name: string) => {
    const view = modelViews.find((v) => v.dataset.modelView === model);
    const map: Record<string, string> = {
      name: model,
      speed: view?.querySelector('.readout div:nth-child(1) dd')?.textContent ?? '',
      peakShort: view?.querySelector('.readout div:nth-child(2) dd')?.textContent ?? '',
      range: view?.querySelector('.readout div:nth-child(3) dd')?.textContent ?? '',
      battery: view?.querySelector('.readout div:nth-child(4) dd')?.textContent ?? '',
      peak: model === 'T-01' ? '8,000 W' : '11,000 W',
      motorShort: model === 'T-01' ? '60V 3,000 W' : '72V 6,000 W',
    };
    return map[name] ?? '';
  };

  let currentModel = 'T-01';

  function selectModel(id: string) {
    currentModel = id;
    spin?.setModel(id);
    modelBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.model === id)));
    modelViews.forEach((v) => (v.hidden = v.dataset.modelView !== id));
    modelTexts.forEach((el) => (el.textContent = field(id, el.dataset.modelText ?? '')));
    compareCols.forEach((c) => c.classList.toggle('is-active', c.dataset.compareCol === id));

    const openTab = document.querySelector<HTMLElement>('[role="tab"][aria-selected="true"]')?.dataset.specTab;
    specPanels.forEach((p) => {
      p.hidden = !(p.dataset.specModel === id && p.dataset.specPanel === openTab);
    });
  }

  modelBtns.forEach((b) => b.addEventListener('click', () => selectModel(b.dataset.model ?? 'T-01')));

  // ---------- Spec tabs (ARIA tabs pattern) ----------
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-spec-tab]'));

  function selectTab(next: HTMLButtonElement, focus = true) {
    tabs.forEach((t) => {
      const on = t === next;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
    });
    specPanels.forEach((p) => {
      p.hidden = !(p.dataset.specModel === currentModel && p.dataset.specPanel === next.dataset.specTab);
    });
    if (focus) next.focus();
  }

  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => selectTab(tab, false));
    tab.addEventListener('keydown', (e) => {
      const moves: Record<string, number> = {
        ArrowRight: i + 1,
        ArrowLeft: i - 1,
        Home: 0,
        End: tabs.length - 1,
      };
      const target = moves[e.key];
      if (target === undefined) return;
      e.preventDefault();
      selectTab(tabs[(target + tabs.length) % tabs.length]);
    });
  });

  // ---------- Quantity ----------
  const qtyOut = document.querySelector<HTMLElement>('[data-qty-value]');
  const MIN_QTY = Number(qtyOut?.textContent ?? 10);
  document.querySelectorAll<HTMLButtonElement>('[data-qty]').forEach((btn) => {
    btn.addEventListener('click', () => {
      if (!qtyOut) return;
      const next = Number(qtyOut.textContent) + Number(btn.dataset.qty);
      qtyOut.textContent = String(Math.max(MIN_QTY, next));
    });
  });

  // ---------- Tagline ----------
  // Words light in sequence once the line arrives. The reveal observer in
  // the layout adds .is-in; this only stages the stagger.
  const tagline = document.querySelector<HTMLElement>('[data-tagline]');
  if (tagline) {
    const words = Array.from(tagline.querySelectorAll<HTMLElement>('.tagline__word'));
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const light = () => words.forEach((w, i) => {
      window.setTimeout(() => w.classList.add('is-lit'), reduce ? 0 : i * 70);
    });
    if ('IntersectionObserver' in window && !reduce) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          light();
          io.disconnect();
        });
      }, { threshold: 0.35 });
      io.observe(tagline);
    } else {
      light();
    }
  }

  // ---------- Deep link ----------
  const wanted = new URLSearchParams(location.search).get('model');
  if (wanted === 'T-02') selectModel('T-02');
  else selectModel('T-01');
</script>

<style>
