  }
  .facts__cell dd { margin-block-start: 5px; font-size: var(--step-0); }

  /* ============================================================
     2 · Panoramic
     ============================================================ */
  .pano {
    position: relative;
    background: var(--bg-well);
    border-block: 1px solid var(--line);
    overflow: hidden;
  }
  .pano__glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(52% 46% at 50% 62%, rgb(196 194 194 / 0.12), rgb(20 20 20 / 0) 72%);
  }
  .pano__inner { position: relative; padding-block: clamp(var(--space-6), 5vw, var(--space-8)); }
  /* ---------- 360° viewer ----------
     The poster is the product photograph and the no-JavaScript view. Once
     frame 0 has decoded, the canvas fades in over it — the same pose, so
     nothing moves — and takes over. The frames are drawn at full contrast
     with their own radial vignette; an elliptical mask centred on the bike
     dissolves that vignette into the section, so it reads as a glow rather
     than a box. */
  .spin {
    position: relative;
    width: min(47.5rem, 94%, calc(82svh * 936 / 980));
    aspect-ratio: 936 / 980;
    margin-inline: auto;
  }
  .spin__frame {
    /* Measured across the whole turn, the bike never leaves 17–89% across
       and 37–86% down (shadow included). This ellipse keeps all of that
       fully opaque — the widest point, the rear fender tip in side profile,
       sits at 0.83 of the radius — and is fully transparent at every edge
       of the box. */
    --feather: radial-gradient(ellipse 50% 40% at 50% 60%, #000 84%, transparent 100%);
    position: absolute;
    inset: 0;
    -webkit-mask-image: var(--feather);
    mask-image: var(--feather);
  }
  .spin__poster,
  .spin__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .spin__canvas {
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease-out);
  }
  .spin.is-ready .spin__canvas { opacity: 1; }

  /* A lit disc under the wheels. The frames already carry the bike's
     shadow; this only lifts the floor around it. */
  .spin__floor {
    position: absolute;
    left: 16%;
    top: 78%;
    width: 68%;
    height: 14%;
    border-radius: 50%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--brand-spin-core) 38%, transparent), transparent);
    mix-blend-mode: screen;
    opacity: 0.35;
    pointer-events: none;
  }

  .spin__hit {
    position: absolute;
    inset: 0;
    border-radius: var(--radius-xl);
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
    -webkit-tap-highlight-color: transparent;
  }
  @media (hover: hover) and (pointer: fine) {
    .spin__hit { cursor: grab; }
    .spin.is-dragging .spin__hit { cursor: grabbing; }
  }
  .spin__hit:focus-visible {
    outline: var(--focus-ring-w) solid var(--focus-ring);
    outline-offset: calc(var(--focus-ring-w) * -1);
