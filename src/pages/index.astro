---
import Base from '../layouts/Base.astro';
import { site, valueProps, marquee, models, testimonials, featured } from '../data/site';
import { hasAsset } from '../data/assets';

const title = 'Electric dirt bikes built around four numbers';
const description = site.description;
const [t01] = models;

// Featured stage. Models that share a render share its elements, so a
// source is only ever loaded and decoded once.
const [lead] = featured.models;
const stageMedia = featured.models.map((m) => m.media);
const stills = [...new Set(stageMedia.flatMap((m) => [m.empty, m.rest]))];
const clips = [...new Set(stageMedia.flatMap((m) => [m.enter, m.out]))];
const fits = new Map(
  stageMedia.flatMap((m) => [m.empty, m.rest, m.enter].map((src) => [src, m.enterFit] as const))
);
const inPoints = new Map(
  stageMedia.flatMap((m) => [[m.enter, m.enterIn] as const, [m.out, m.outIn] as const])
);
const fitStyle = (src: string) => {
  const fit = fits.get(src);
  return fit ? `--fit-scale:${fit.scale};--fit-x:${fit.x}%;--fit-y:${fit.y}%` : undefined;
};

// Photographs exported from the design project. Missing ones fall back to a
// labelled slot rather than a broken image.
const bikePhoto = hasAsset('/photos/bike-t01.jpg');
const riderPhoto = hasAsset('/photos/rider-liam.png');

/* Hero readout. The landing design carries three; these are the three the
   spec sheet actually supports. */
const heroStats = [
  { label: 'Peak power', value: t01.peakShort },
  { label: 'Top speed', value: t01.speed },
  { label: 'Eco range', value: t01.range },
];

/* Icon paths for the value-prop bar, lifted from the imported design. */
const icons: Record<string, string> = {
  globe: 'M3 12h18M12 3c2.6 2.7 2.6 15.3 0 18M12 3c-2.6 2.7-2.6 15.3 0 18',
  shield: 'M12 3l7 3v6c0 4.2-2.9 7.6-7 9-4.1-1.4-7-4.8-7-9V6l7-3zM9 12l2 2 4-4',
  lock: 'M8 10V7a4 4 0 0 1 8 0v3',
  factory: 'M3 20V9l6 4V9l6 4V4h5v16z',
};
---

<Base title={title} description={description}>
  <!-- ========== 1 · HERO ==========
       Full-bleed bike shot masked into the right of the frame, a crimson
       bloom behind it, and the headline holding the left. -->
  <section class="hero" id="top" aria-labelledby="hero-title">
    <div class="hero__photo" style={bikePhoto ? "--photo:url(/photos/bike-t01.jpg)" : undefined} aria-hidden="true"></div>
    <div class="hero__bloom" aria-hidden="true"></div>
    <div class="hero__scrim" aria-hidden="true"></div>
    <div class="hero__floor" aria-hidden="true"></div>

    <div class="page hero__body">
      <p class="eyebrow" data-reveal>Electric dirt bikes, factory direct</p>

      <h1 class="hero__title" id="hero-title" data-reveal>
        8 kW of dirt bike.<br /><span class="hero__title-alt">55 kg of it.</span>
      </h1>

      <p class="hero__lede" data-reveal>
        The T-01 runs a 60V central motor that peaks at 8,000 W, carries a
        150 kg rated load, and still weighs less than every bike it is
        cross-shopped against.
      </p>

      <div class="cluster hero__actions" data-reveal>
        <a class="btn btn--primary" href="/products/t-01">Configure the T-01</a>
        <a class="btn btn--ghost" href="/products/t-01#compare">Compare models</a>
      </div>

      <dl class="hero__rail" data-reveal>
        {heroStats.map((s) => (
          <div class="hero__stat">
            <dt>{s.label}</dt>
            <dd>{s.value}</dd>
          </div>
        ))}
        <!-- TODO(asset): the design reserves this corner for the looping
             hero video. Drop a <video autoplay muted loop playsinline>
             into .hero__photo and delete this note. -->
        <p class="hero__note">Looping hero video goes here</p>
      </dl>
    </div>
  </section>

  <!-- ========== 2 · VALUE PROPS ========== -->
  <section class="props" aria-label="What every order includes">
    <ul class="page props__list">
      {valueProps.map((p) => (
        <li class="props__item" data-reveal>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            {p.icon === 'globe' && <circle cx="12" cy="12" r="9" />}
            {p.icon === 'lock' && <rect x="4" y="10" width="16" height="10" rx="2" />}
            <path d={icons[p.icon]} />
          </svg>
          <span>{p.label}</span>
        </li>
      ))}
    </ul>
  </section>

  <!-- ========== 3 · ABOUT / TRUST ========== -->
  <section class="section about" id="about" aria-labelledby="about-title">
    <div class="page about__grid">
      <div data-reveal>
        <p class="eyebrow">Who rides a Panquire</p>
        <h2 id="about-title" class="about__title">Built by riders, sold without the middle man</h2>
        <p class="about__text">
          We started in a two-bay workshop stripping every light electric dirt
          bike we could get hold of, and kept finding the same trade: real
          suspension and real power, or a price a rider could actually justify.
          Never both.
        </p>
        <p class="about__text">
          Every frame is assembled on our own line and shipped straight from
          the factory floor. That is why an 8 kW bike lands at the price of a
          mid-range commuter.
        </p>
        <p class="about__cta"><a class="btn btn--ghost" href="/about">About us</a></p>
      </div>

      <figure class="about__figure" data-reveal>
        <div class="about__glow" aria-hidden="true"></div>
        {riderPhoto ? (
          <img class="about__photo" src="/photos/rider-liam.png" alt="Rider on a blacked-out bike at dusk" width="797" height="682" loading="lazy" />
        ) : (
          <div class="about__photo slot">Rider photograph</div>
        )}
      </figure>
    </div>
  </section>

  <!-- ========== 4 · MARQUEE ==========
       A spec ticker, not decoration: every word in it is a figure from
       the sheet. -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      {[0, 1].map(() => (
        <div class="marquee__run">
          {marquee.map((m) => (
            <span class={m.accent ? 'marquee__word marquee__word--accent' : 'marquee__word'}>{m.text}</span>
          ))}
        </div>
      ))}
    </div>
  </div>

  <!-- ========== 5 · FEATURED PRODUCTS ==========
       The renders carry the whole composition — ground, dirt, copy and
       nameplates — so only the bike moves. The same copy lives in the HTML
       for search engines and screen readers, and real buttons sit over the
       painted nameplates. The stage controller in the script below runs it. -->
  <section class="showcase" id="bikes" aria-label="Featured products">
    <div class="stage" data-stage data-baked-copy>
      <div class="stage__frame" aria-hidden="true">
        {stills.map((src) => (
          <img
            class="stage__still"
            src={src}
            data-src={src}
            alt=""
            width="1112"
            height="834"
            loading="lazy"
            decoding="async"
            hidden={src !== lead.media.rest}
            style={fitStyle(src)}
          />
        ))}
        {clips.map((src) => (
          <video
            class="stage__video"
            src={src}
            data-src={src}
            data-in={inPoints.get(src)}
            style={fitStyle(src)}
            muted
            playsinline
            preload="none"
            disablepictureinpicture
            disableremoteplayback
            tabindex="-1"
          ></video>
        ))}
      </div>

      <div class="stage__zone" data-stage-zone aria-hidden="true"></div>

      <div class="stage__copy" aria-live="polite">
        <p class="stage__brand">
          <span class="stage__brand-name">{featured.brand.name}</span>
          <span class="stage__brand-tagline">{featured.brand.tagline}</span>
        </p>
        {featured.models.map((m, i) => (
          <div class="stage__model" data-copy={m.id} hidden={i !== 0}>
            <h2 class="stage__label">{m.label}</h2>
            <p class="stage__blurb">{m.blurb}</p>
            <dl class="stage__specs">
              {m.specs.map(([term, value]) => (
                <div><dt>{term}</dt><dd>{value}</dd></div>
              ))}
            </dl>
          </div>
        ))}
      </div>

      <div class="stage__switch" role="group" aria-label="Choose a model">
        {featured.models.map((m, i) => (
          <button
            class="stage__plate"
            type="button"
            aria-pressed={i === 0 ? 'true' : 'false'}
            data-switch={m.id}
            data-enter={m.media.enter}
            data-out={m.media.out}
            data-empty={m.media.empty}
            data-rest={m.media.rest}
            data-enter-settle={m.media.enterSettle}
          >
            <span class="stage__plate-name">{m.id}</span>
          </button>
        ))}
      </div>

      <script is:inline>
        // Runs during parse, before first paint. With motion allowed the
        // stage starts empty, so the entrance plays instead of the bike
        // blinking out and riding back in. If the controller never takes
        // over, the resting frame comes back.
        (function (stage) {
          if (!window.matchMedia || !matchMedia('(prefers-reduced-motion: no-preference)').matches) return;
          var lead = stage.querySelector('[data-switch]');
          var show = function (src) {
            stage.querySelectorAll('.stage__still').forEach(function (img) {
              img.hidden = img.getAttribute('data-src') !== src;
            });
          };
          stage.setAttribute('data-pending', '');
          show(lead.getAttribute('data-empty'));
          setTimeout(function () {
            if (!stage.hasAttribute('data-pending')) return;
            stage.removeAttribute('data-pending');
            show(lead.getAttribute('data-rest'));
          }, 6000);
        })(document.currentScript.parentElement);
      </script>
    </div>
  </section>

  <!-- ========== 6 · TESTIMONIALS ========== -->
  <section class="section owners" id="owners" aria-labelledby="owners-title">
    <div class="page">
      <div class="owners__head" data-reveal>
        <p class="eyebrow">Testimonials</p>
        <h2 id="owners-title">Owners, not reviewers</h2>
      </div>

      <ul class="owners__list">
        {testimonials.map((t, i) => (
          <li class="review" data-reveal data-reveal-delay={i * 70}>
            {t.photo && hasAsset(t.photo) ? (
              <img class="review__photo" src={t.photo} alt={t.alt} width="797" height="682" loading="lazy" />
            ) : (
              <div class="review__photo slot">Owner photograph</div>
            )}

            <p class="review__rating" aria-label={`Rated ${t.rating} out of 5`}>
              <span aria-hidden="true">{'★'.repeat(t.rating)}</span>
            </p>

            <blockquote class="review__quote"><p>{t.quote}</p></blockquote>

            <footer class="review__by">
              {t.avatar && hasAsset(t.avatar) ? (
                <img class="review__avatar" src={t.avatar} alt="" width="112" height="112" loading="lazy" />
              ) : (
                <span class="review__initials" aria-hidden="true">{t.initials}</span>
              )}
              <span class="review__name">{t.name}, verified owner</span>
            </footer>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ========== 7 · LEAD CAPTURE ==========
       One field. The comparison goes to the inbox, not onto the page. -->
  <section class="capture" id="compare" aria-labelledby="capture-title">
    <div class="capture__photo" style={bikePhoto ? "--photo:url(/photos/bike-t01.jpg)" : undefined} aria-hidden="true"></div>
    <div class="capture__scrim" aria-hidden="true"></div>

    <div class="capture__body">
      <p class="eyebrow eyebrow--accent capture__eyebrow" data-reveal>Direct comparison</p>
      <h2 id="capture-title" data-reveal>How the T-01 measures up against the top 7</h2>
      <p class="capture__lede" data-reveal>
        We put our full spec sheet next to the seven bikes people cross-shop
        us with, including the numbers that do not flatter us. It goes to
        your inbox, not on this page.
      </p>

      <!-- TODO(backend): point action at the list provider before launch. -->
      <form class="capture__form" data-capture data-reveal method="post" action="#">
        <label class="visually-hidden" for="lead-email">Email address</label>
        <input
          class="input capture__input"
          id="lead-email"
          name="email"
          type="email"
          required
          autocomplete="email"
          placeholder="you@email.com"
        />
        <button class="btn btn--primary" type="submit">Send the comparison</button>
      </form>

      <p class="capture__done" data-capture-done hidden role="status">
        Check your inbox. The comparison is on its way.
      </p>

      <p class="capture__note">One email, no list, unsubscribe in a click.</p>
    </div>
  </section>
</Base>

<script>
  // Lead capture. The design shows a confirmation in place of the form;
  // this swaps the two until the list provider is wired up.
  const form = document.querySelector<HTMLFormElement>('[data-capture]');
  const done = document.querySelector<HTMLElement>('[data-capture-done]');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;
    form.hidden = true;
    if (done) done.hidden = false;
  });

  /* ============================================================
     Featured-products stage controller.

     Each model has two pre-rendered clips with the whole composition
     baked in. Three rules keep every handover invisible:
       1. an incoming clip is painted *under* the live one and raised only
          once its first frame is on screen — never an empty frame;
       2. the matching still is swapped in underneath while a clip covers
          it, so a clip ending just uncovers identical pixels;
       3. clips start at measured in-points, skipping the static frames
          the renders open with.
     A click mid-clip is remembered and the stage lands on the last model
     asked for. During an entrance it waits for the bike to settle, then
     cuts straight to the departure.
     ============================================================ */
  const stage = document.querySelector<HTMLElement>('[data-stage]');

  if (stage) {
    const videos = [...stage.querySelectorAll<HTMLVideoElement>('.stage__video')];
    const stills = [...stage.querySelectorAll<HTMLImageElement>('.stage__still')];
    const buttons = [...stage.querySelectorAll<HTMLButtonElement>('[data-switch]')];
    const copies = [...stage.querySelectorAll<HTMLElement>('[data-copy]')];
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    const clip = (src: string) => videos.find((v) => v.dataset.src === src)!;
    const media = (id: string) => {
      const d = buttons.find((b) => b.dataset.switch === id)!.dataset;
      return {
        enter: clip(d.enter!),
        out: clip(d.out!),
        empty: d.empty!,
        rest: d.rest!,
        settle: Number(d.enterSettle),
      };
    };
    const inPoint = (v: HTMLVideoElement) => Number(v.dataset.in) || 0;

    // `shown` is the model on stage — arriving, resting or departing.
    // `wanted` is the last one asked for. Buttons and copy follow `wanted`
    // at once; the stage catches up at its own pace.
    let shown = buttons[0].dataset.switch!;
    let wanted = shown;
    let phase: 'waiting' | 'entering' | 'rest' | 'leaving' = stage.hasAttribute('data-pending')
      ? 'waiting'
      : 'rest';
    let run = 0; // bumped by a fallback, so promises from an abandoned run stay quiet
    stage.removeAttribute('data-pending');

    const showStill = (src: string) =>
      stills.forEach((img) => {
        img.hidden = img.dataset.src !== src;
      });

    function reflect(id: string) {
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.switch === id)));
      copies.forEach((c) => {
        c.hidden = c.dataset.copy !== id;
      });
    }

    /** Starts loading a clip (once) and resolves when it can show a frame. */
    const ready = (v: HTMLVideoElement) =>
      new Promise<void>((done) => {
        if (v.preload !== 'auto') {
          v.preload = 'auto';
          v.load();
        }
        if (v.readyState >= 2) return done();
        v.addEventListener('loadeddata', () => done(), { once: true });
      });

    const seek = (v: HTMLVideoElement, t: number) =>
      new Promise<void>((done) => {
        if (Math.abs(v.currentTime - t) < 0.02) return done();
        v.addEventListener('seeked', () => done(), { once: true });
        v.currentTime = t;
      });

    /** Resolves once the clip has put its first new frame on screen. */
    const presented = (v: HTMLVideoElement) =>
      new Promise<void>((done) => {
        if ('requestVideoFrameCallback' in v) v.requestVideoFrameCallback(() => done());
        else v.addEventListener('playing', () => requestAnimationFrame(() => done()), { once: true });
      });

    const ended = (v: HTMLVideoElement) =>
      new Promise<void>((done) => v.addEventListener('ended', () => done(), { once: true }));

    const within = (ms: number) => new Promise<false>((r) => setTimeout(() => r(false), ms));

    const live = () => videos.find((v) => v.dataset.layer === 'live');

    function retire(v: HTMLVideoElement) {
      delete v.dataset.layer;
      v.pause();
      void seek(v, inPoint(v));
    }

    /** Paints a clip under the live layer, plays it, raises it once its first frame is up. */
    async function cue(v: HTMLVideoElement) {
      const token = run;
      await ready(v);
      await seek(v, inPoint(v));
      if (token !== run) return false;
      v.dataset.layer = 'armed';
      const firstFrame = presented(v);
      await v.play();
      await firstFrame;
      if (token !== run) return false;
      const previous = live();
      v.dataset.layer = 'live';
      if (previous && previous !== v) retire(previous);
      return true;
    }

    /** Autoplay refused, a clip that never loads: settle on the resting frame. */
    function toRest(id: string) {
      run++;
      videos.forEach((v) => {
        if (v.dataset.layer) retire(v);
      });
      shown = id;
      showStill(media(id).rest);
      phase = 'rest';
    }

    async function enter(id: string) {
      const m = media(id);
      shown = id;
      phase = 'entering';
      showStill(m.empty);
      if (!(await Promise.race([cue(m.enter).catch(() => false), within(4000)]))) return toRest(wanted);
      showStill(m.rest); // underneath the clip: its last frame uncovers this

      // Play to the end — unless another model is wanted, in which case
      // leave as soon as the bike has settled.
      await new Promise<void>((done) => {
        const settled = () => {
          if (wanted !== shown && m.enter.currentTime >= m.settle) finish();
        };
        const finish = () => {
          m.enter.removeEventListener('timeupdate', settled);
          m.enter.removeEventListener('ended', finish);
          done();
        };
        m.enter.addEventListener('timeupdate', settled);
        m.enter.addEventListener('ended', finish);
      });

      phase = 'rest';
      if (wanted !== shown) return leave();
      retire(m.enter); // ended: the resting still underneath takes over
    }

    async function leave() {
      phase = 'leaving';
      const out = media(shown).out;
      if (!(await cue(out).catch(() => false))) return toRest(wanted);
      await ended(out);
      // Whichever model is wanted by now arrives: clicks during the departure count.
      await enter(wanted); // raises the entrance over the held last frame, then retires `out`
    }

    function switchTo(next: string) {
      if (next === wanted) return;
      wanted = next;
      reflect(next);
      if (reduce) {
        shown = next;
        return showStill(media(next).rest);
      }
      if (phase === 'waiting') {
        shown = next; // the entrance has not played yet, so it plays this model
        return showStill(media(next).empty);
      }
      if (phase === 'rest') void leave();
      // Entering or leaving: the running sequence reads `wanted` when it gets there.
    }

    buttons.forEach((b) => b.addEventListener('click', () => switchTo(b.dataset.switch!)));

    if (!reduce && 'IntersectionObserver' in window) {
      // Warm every clip and still a screen and a half before the stage.
      const near = new IntersectionObserver(
        (entries) => {
          if (!entries.some((e) => e.isIntersecting)) return;
          near.disconnect();
          videos.forEach((v) => ready(v).then(() => seek(v, inPoint(v))));
          stills.forEach((img) => {
            img.loading = 'eager';
            img.decode().catch(() => {});
          });
        },
        { rootMargin: '150% 0px' }
      );
      near.observe(stage);

      if (phase === 'waiting') {
        const seen = new IntersectionObserver(
          (entries) => {
            if (!entries.some((e) => e.isIntersecting)) return;
            seen.disconnect();
            void enter(wanted);
          },
          { threshold: 0.6 }
        );
        seen.observe(stage.querySelector<HTMLElement>('[data-stage-zone]')!);
      }
    } else if (phase === 'waiting') {
      toRest(wanted);
    }
  }
</script>

<style>
  /* ============================================================
     1 · Hero
     ============================================================ */
  .hero {
    position: relative;
    min-height: 92svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    isolation: isolate;
    background: radial-gradient(120% 90% at 70% 30%, #2A2A2C 0%, var(--bg) 55%, var(--bg-deep) 100%);
  }
  .hero__photo,
  .hero__bloom,
  .hero__scrim,
  .hero__floor { position: absolute; inset: 0; z-index: -1; }

  /* The photograph is handed in as --photo only when the file exists, so a
     missing export degrades to the gradient ground instead of a broken URL. */
  .hero__photo {
    background-image: var(--photo, none);
    background-size: min(43.75rem, 64%) auto;
    background-position: 118% 66%;
    background-repeat: no-repeat;
    -webkit-mask-image: radial-gradient(68% 62% at 66% 60%, #000 42%, transparent 88%);
    mask-image: radial-gradient(68% 62% at 66% 60%, #000 42%, transparent 88%);
  }
  .hero__bloom {
    inset: 8% auto auto -10%;
    width: 70%;
    height: 70%;
    background: var(--grad-glow);
    filter: blur(20px);
    animation: hero-pulse var(--dur-pulse) ease-in-out infinite;
    pointer-events: none;
  }
  .hero__scrim {
    background: linear-gradient(90deg, var(--a-carbon-92) 0%, rgb(18 18 20 / 0.82) 38%, rgb(18 18 20 / 0.15) 72%, rgb(18 18 20 / 0.7) 100%);
  }
  .hero__floor {
    background: linear-gradient(0deg, var(--bg) 0%, rgb(26 26 26 / 0) 34%);
  }
  @keyframes hero-pulse {
    0%, 100% { opacity: 0.55; }
    50%      { opacity: 0.85; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__bloom { animation: none; opacity: 0.7; }
  }

  .hero__body {
    position: relative;
    z-index: var(--z-base);
    padding-block: calc(var(--header-h) + var(--space-9)) var(--space-7);
  }
  .hero__title {
    margin-block-start: var(--space-6);
    max-width: 15ch;
    font-size: var(--step-6);
  }
  /* The second line takes the gradient, so the type itself carries the
     accent instead of a coloured word inside a sentence. */
  .hero__title-alt {
    background: var(--grad-headline);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero__lede {
    margin-block-start: var(--space-6);
    max-width: var(--measure);
    font-size: var(--step-1);
    color: var(--text-muted);
  }
  .hero__actions { margin-block-start: var(--space-7); gap: var(--space-4); }

  .hero__rail {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--space-4) var(--space-9);
    margin-block-start: var(--space-9);
    padding-block-start: var(--space-5);
    border-block-start: 1px solid var(--a-white-09);
  }
  .hero__stat dt {
    font-size: var(--step--2);
    font-weight: var(--weight-semi);
    letter-spacing: var(--tracking-mark);
    text-transform: uppercase;
    color: var(--text-label);
  }
  .hero__stat dd {
    margin-block-start: var(--space-2);
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: var(--weight-bold);
    font-variant-numeric: tabular-nums;
  }
  .hero__note {
    margin-inline-start: auto;
    font-size: var(--step--2);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-mark);
