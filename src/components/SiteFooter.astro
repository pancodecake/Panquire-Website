---
import { footerColumns, site, withBase } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="page footer__inner">
    <div class="footer__brand">
      <a class="footer__logo" href={withBase('/')}>
        <span class="footer__name">{site.name}</span>
        <span class="footer__chevron" aria-hidden="true"></span>
      </a>
      <p class="footer__line">
        Electric dirt bikes, built on our own line and shipped from the
        factory floor.
      </p>
      <p class="footer__legal">{site.legalName}</p>
    </div>

    {footerColumns.map((col) => (
      <nav class="footer__col" aria-label={col.title}>
        <h2 class="footer__title">{col.title}</h2>
        <ul class="footer__list">
          {col.links.map((l) => (
            <li><a class="footer__link" href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      </nav>
    ))}
  </div>

  <div class="page">
    <div class="footer__bar">
      <ul class="footer__bar-links">
        <li><a href={withBase('/terms')}>Terms of service</a></li>
        <li><a href={withBase('/partners#affiliate-terms')}>Affiliate terms</a></li>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
      </ul>
      <p>&copy; {year} {site.name}. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: linear-gradient(180deg, var(--brand-ink-lift), var(--brand-ink));
    border-block-start: 1px solid var(--line-hairline);
  }

  .footer__inner {
    display: grid;
    grid-template-columns: minmax(12.5rem, 1fr) repeat(4, minmax(11.25rem, 1fr));
    gap: var(--space-7) var(--space-6);
    padding-block-start: clamp(var(--space-8), 7vw, var(--space-9));
  }
  @media (max-width: 68rem) {
    .footer__inner { grid-template-columns: repeat(auto-fit, minmax(11.25rem, 1fr)); }
    .footer__brand { grid-column: 1 / -1; }
  }

  .footer__logo { display: inline-flex; align-items: center; gap: var(--space-2); }
  .footer__name {
    font-family: var(--font-display);
    font-weight: var(--weight-black);
    font-style: italic;
    font-size: var(--step-2);
    text-transform: uppercase;
  }
  .footer__chevron {
    display: block;
    width: 1.5rem;
    height: 0.6875rem;
    background: var(--grad-chevron);
    clip-path: polygon(18% 0, 100% 0, 82% 100%, 0 100%);
  }
  .footer__line {
    margin-block-start: var(--space-4);
    max-width: 28ch;
    font-size: var(--step-0);
    color: var(--text-label);
  }
  .footer__legal { margin-block-start: var(--space-3); font-size: var(--step--1); color: var(--text-faint); }

  .footer__title {
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-mark);
    text-transform: uppercase;
    color: var(--text);
    line-height: var(--leading-snug);
  }
  .footer__list {
    list-style: none;
    padding: 0;
    margin-block-start: var(--space-5);
    display: grid;
    gap: var(--space-3);
  }
  .footer__link { font-size: var(--step-0); color: var(--text-muted); }

  .footer__bar {
    margin-block-start: clamp(var(--space-7), 5vw, var(--space-8));
    padding-block: var(--space-5);
    border-block-start: 1px solid var(--line-hairline);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-6);
    align-items: center;
    justify-content: space-between;
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    color: var(--text-faint);
  }
  .footer__bar-links { display: flex; flex-wrap: wrap; gap: var(--space-5); list-style: none; padding: 0; }
  .footer__bar-links a { color: var(--text-faint); }
</style>
